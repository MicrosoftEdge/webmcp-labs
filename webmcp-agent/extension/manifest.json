{
  "manifest_version": 3,
  "name": "WebMCP Agent",
  "version": "0.1.0",
  "description": "An agent that completes tasks on web pages using their WebMCP tools.",
  "minimum_chrome_version": "156",
  "key": "",
  "permissions": ["sidePanel", "storage", "tabs", "webNavigation", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "WebMCP Agent" }
}
