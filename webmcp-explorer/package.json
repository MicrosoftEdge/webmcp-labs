{
  "name": "webmcp-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "marked": "^15.0.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "playwright": "1.64.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
